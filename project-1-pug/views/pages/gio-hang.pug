extends ../layouts/default.pug

block title
    title Trang chủ

block main
  // Section 11
  .section-11
    .container
      .inner-wrap
        .inner-head
          h1.inner-title Giỏ Hàng
          a.inner-back(href="#")
            | Quay lại mua hàng
            i.fa-solid.fa-angle-right
        .inner-tour-list
          .inner-tour-item
            .inner-actions
              span.inner-remove
                i.fa-solid.fa-xmark
              input.inner-check(type="checkbox")
            .inner-product
              a.inner-image(href="#")
                img(
                  alt="" 
                  src="assets/images/demo/product-1.jpg"
                  )
              .inner-content
                h3.inner-title
                  a(href="#") Tour Châu Âu Đón Noel | 11N10D | Pháp – Thụy Sĩ – Ý
                .inner-desc
                  div
                    | Mã Tour:
                    b 123456789
                  div
                    | Ngày Khởi Hành:
                    b 20/10/2024
                  div
                    | Khởi Hành Tại:
                    b Hà Nội
            .inner-quantity
              .inner-label Số Lượng Hành Khách
              .inner-list
                .inner-item
                  label(for="") Người lớn:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span
                    | 1 x
                    span.text-main 10.000.000
                .inner-item
                  label(for="") Trẻ em:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span
                    | 0 x
                    span.text-main 7.990.000
                .inner-item
                  label(for="") Em bé:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span
                    | 0 x
                    span.text-main 5.990.000
          .inner-tour-item
            .inner-actions
              span.inner-remove
                i.fa-solid.fa-xmark
              input.inner-check(type="checkbox")
            .inner-product
              a.inner-image(href="#")
                img(
                  alt="" 
                  src="assets/images/demo/product-1.jpg"
                  )
              .inner-content
                h3.inner-title
                  a(href="#") Tour Châu Âu Đón Noel | 11N10D | Pháp – Thụy Sĩ – Ý
                .inner-desc
                  div
                    | Mã Tour:
                    b 123456789
                  div
                    | Ngày Khởi Hành:
                    b 20/10/2024
                  div
                    | Khởi Hành Tại:
                    b Đà Nẵng
            .inner-quantity
              .inner-label Số Lượng Hành Khách
              .inner-list
                .inner-item
                  label(for="") Người lớn:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span
                    | 1 x
                    span.text-main 10.000.000
                .inner-item
                  label(for="") Trẻ em:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span
                    | 0 x
                    span.text-main 7.990.000
                .inner-item
                  label(for="") Em bé:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span
                    | 0 x
                    span.text-main 5.990.000
        .inner-coupon
          form(action="")
            input(
              placeholder="Nhập mã giảm giá" 
              type="text"
              )
            button Dùng Mã
        .inner-price-list
          .inner-item
            .inner-label Tổng tiền:
            .inner-price 15.070.000đ
          .inner-item
            .inner-label Giảm:
            .inner-price -5.070.000đ
          .inner-item
            .inner-label Thanh toán:
            .inner-price-hl 17.070.000đ
  // End Section 11
  // Section 12
  .section-12
    .container
      form.inner-wrap(action="")
        h2.inner-title-main Thông Tin Khách Hàng
        .inner-group-list
          .inner-group
            input(
              placeholder="Họ và tên" 
              name="" 
              type="text"
              )
          .inner-group
            input(
              placeholder="Số điện thoại" 
              name="" 
              type="text"
              )
          .inner-group.inner-group-full
            textarea(
              placeholder="Ghi chú" 
              name="" 
              type="text"
              )
        h2.inner-title-main Chọn phương thức thanh toán
        .inner-payment-list
          .inner-item
            input(
              name="" 
              type="checkbox"
              )
            label(for="") Thanh toán tiền mặt khi đi tour
          .inner-item
            input(
              name="" 
              type="checkbox"
              )
            label(for="") Ví Momo
          .inner-item
            input(
              name="" 
              type="checkbox"
              )
            label(for="") Chuyển khoản ngân hàng
        .inner-bank
          .inner-title Thông tin chuyển khoản
          .inner-text
            div Ngân hàng : Vietcombank
            div Tên tài khoản: Le Van A
            div STK: 0123456789
        .inner-button
          button ĐẶT TOUR
  // End Section 12