      alt="" 
      src="assets/images/demo/banner-6.jpg"
      )
    .inner-content
      .container
        h1.inner-title Tour Nước Ngoài
        .inner-list
          a(href="#") Trang Chủ
          i.fa-solid.fa-angles-right
          a(href="#") Tour Nước Ngoài
  // End Box Breadcrumb
