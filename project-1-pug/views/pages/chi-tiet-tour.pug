extends ../layouts/default.pug

block title
    title Trang chủ

block main
  // Box Breadcrumb
  .box-breadcrumb
    img.inner-image(
      alt="" 
      src="assets/images/demo/banner-6.jpg"
      )
    .inner-content
      .container
        h1.inner-title Tour Nước Ngoài
        .inner-list
          a(href="#") Trang Chủ
          i.fa-solid.fa-angles-right
          a(href="#") Tour Trong Nước
          i.fa-solid.fa-angles-right
          a(href="#") Tour Miền Bắc
          i.fa-solid.fa-angles-right
          a(href="#") Tour Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D
  // End Box Breadcrumb
  // Section 10
  .section-10
    .container
      .inner-wrap
        .inner-left
          // Danh sách ảnh
          .box-images
            .inner-image-main
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
            .inner-image-thumb
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
          // Hết danh sách ảnh
          // Thông Tin Tour
          .box-tour-info
            h2.inner-title-main Thông Tin Tour
            .inner-content
              p
                | Nói về dịch vụ, chắc chắn rồi, với một tiêu chí của một khách sạn 5 sao đẳng cấp, mình
                |   tin rằng Indochine Palace đủ để cho bạn đánh giá 6 sao. Từ nhà hàng, cà phê, đến trung
                |   tâm thể dục thể thao hiện đại đến Spa, xông hơi… tất tần tật các dịch vụ mà bạn mong
                |   muốn đều có ở đây.. Từ nhà hàng, cà phê, đến trung tâm thể dục thể thao hiện đại đến
                |   Spa, xông hơi… tất tần tật các dịch vụ mà bạn mong muốn đều có ở đây. . Từ nhà hàng, cà
                |   phê, đến trung tâm thể dục thể thao hiện đại đến Spa, xông hơi…
              img(
                alt="" 
                src="assets/images/demo/banner-7.jpg"
                )
            .inner-button
              button.button-outline Xem tất cả
          // Hết Thông Tin Tour
          // Lịch Trình Tour
          .box-tour-schedule
            h2.inner-title-main Lịch Trình Tour
            .inner-list
              .inner-line
              .inner-item
                .inner-dot
                h3.inner-title NGÀY 1 | TP.HCM – THỦ ĐÔ HÀ NỘI
                .inner-content
                  p
                    | Sáng: HDV TOPTEN TRAVEL® Đón Quý Khách tại sân bay Tân Sơn Nhất làm thủ tục check in
                    |   cho đoàn đi Hà Nội (Quý Khách vui lòng có mặt ở sân bay trước 2 tiếng so với giờ
                    |   bay. Đến sân bay Hà Nội – Xe và HDV đón Đoàn đưa về Khách sạn nghỉ ngơi. Đoàn dùng
                    |   bữa trưa tại Nhà Hàng.
                    |   Chiều: Tham quan
                    |   Viếng Chùa Trấn Quốc – Ngôi chùa Trấn Bắc cổ kính nhất Việt Nam với 1.500 năm tuổi
                    |   nằm trên bán đảo cồn Quy linh thiêng, với truyền thuyết và huyền thoại về Hồ Tây, hồ
                    |   Trúc Bạch.
                    |   Đền Ngọc Sơn, Cầu Thê Húc, hồ Hoàn Kiếm - Trực tiếp chứng kiến cụ Rùa dài 2,1m,
                    |   ngang 1,2m được trưng bày tại đền Ngọc Sơn.
                    |   Văn Miếu Quốc Tử Giám – Nơi đựoc xem như Trường Đại học đầu tiên của Việt Nam với 82
                    |   tấm bia Tiến sỹ còn lưu danh sử sách.
                    |   Tối: Đoàn dùng cơm tối tại nhà hàng. Đoàn tự do nghỉ ngơi hoặc dạo chơi thăm phố cổ
                    |   Hà Nội, dạo Hồ Gươm, mua sắm tại Chợ đêm Hà Nội sầm uất...
                  img(
                    alt="" 
                    src="assets/images/demo/banner-7.jpg"
                    )
              .inner-item
                .inner-dot
                h3.inner-title NGÀY 2 | THỦ ĐÔ HÀ NỘI -  TP.HCM
                .inner-content
                  p
                    | Sáng: HDV TOPTEN TRAVEL® Đón Quý Khách tại sân bay Tân Sơn Nhất làm thủ tục check in
                    |   cho đoàn đi Hà Nội (Quý Khách vui lòng có mặt ở sân bay trước 2 tiếng so với giờ
                    |   bay. Đến sân bay Hà Nội – Xe và HDV đón Đoàn đưa về Khách sạn nghỉ ngơi. Đoàn dùng
                    |   bữa trưa tại Nhà Hàng.
                    |   Chiều: Tham quan
                    |   Viếng Chùa Trấn Quốc – Ngôi chùa Trấn Bắc cổ kính nhất Việt Nam với 1.500 năm tuổi
                    |   nằm trên bán đảo cồn Quy linh thiêng, với truyền thuyết và huyền thoại về Hồ Tây, hồ
                    |   Trúc Bạch.
                    |   Đền Ngọc Sơn, Cầu Thê Húc, hồ Hoàn Kiếm - Trực tiếp chứng kiến cụ Rùa dài 2,1m,
                    |   ngang 1,2m được trưng bày tại đền Ngọc Sơn.
                    |   Văn Miếu Quốc Tử Giám – Nơi đựoc xem như Trường Đại học đầu tiên của Việt Nam với 82
                    |   tấm bia Tiến sỹ còn lưu danh sử sách.
                    |   Tối: Đoàn dùng cơm tối tại nhà hàng. Đoàn tự do nghỉ ngơi hoặc dạo chơi thăm phố cổ
                    |   Hà Nội, dạo Hồ Gươm, mua sắm tại Chợ đêm Hà Nội sầm uất...
                  img(
                    alt="" 
                    src="assets/images/demo/banner-7.jpg"
                    )
          // Hết Lịch Trình Tour
        .inner-right
          // Chuyến Đi Của Bạn
          .box-tour-detail
            h2.inner-title-main Chuyến Đi Của Bạn
            .inner-product
              img(
                alt="Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D" 
                src="assets/images/demo/product-1.jpg"
                )
              .inner-info
                .inner-title Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D
                .inner-rating
                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-regular.fa-star
                  .inner-number 500 lượt đánh giá
            .inner-desc
              .inner-desc-item
                i.fa-solid.fa-ticket
                span
                  | Mã Tour:
                  span.text-main 28T00001
              .inner-desc-item
                i.fa-solid.fa-calendar-days
                span
                  | Thời gian:
                  span.text-main 6 Ngày 5 Đêm
              .inner-desc-item
                i.fa-solid.fa-car
                span
                  | Phương Tiện:
                  span.text-main Ô tô 45 chỗ
              .inner-desc-item
                i.fa-solid.fa-calendar-days
                span
                  | Ngày Khởi Hành:
                  span.text-main 20/10/2024
            .inner-group
              label.inner-label(for="") Khởi Hành Tại:
              select(name="")
                option(value="") Hà Nội
                option(value="") Đà Nẵng
                option(value="") Nha Trang
            .inner-group
              label.inner-label(for="") Số Lượng Hành Khách
              .inner-list
                .inner-item
                  label(for="") Người Lớn:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 1 x
                    span.text-main 10.000.000
                .inner-item
                  label(for="") Trẻ Em:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 0 x
                    span.text-main 7.990.000
                .inner-item
                  label(for="") Em Bé:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 0 x
                    span.text-main 5.990.000
            .inner-total
              .inner-label Tổng cộng:
              .inner-price.text-main 10.000.000đ
            button.inner-button Thêm Vào Giỏ Hàng
          // Hết Chuyến Đi Của Bạn
  // End Section 10 